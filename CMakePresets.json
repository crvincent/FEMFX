{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_PROCESSOR": "AMD64",
        "FEMFX_BACKEND": "SSE2"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64 (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FEMFX_EXPECT_ARM64": "ON",
        "FEMFX_BACKEND": "SCALAR"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_PROCESSOR": "AMD64",
        "FEMFX_BACKEND": "SSE2"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux ARM64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "FEMFX_BACKEND": "SCALAR"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS ARM64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_SYSTEM_PROCESSOR": "arm64",
        "FEMFX_BACKEND": "SCALAR"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64"
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64"
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64"
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64"
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    }
  ]
}
